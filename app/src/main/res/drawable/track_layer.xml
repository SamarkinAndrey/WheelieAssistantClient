<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="48dp"
        android:height="24dp">
        <selector>
            <item android:state_checked="true">
                <shape
                    android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#E02828" />
                    <size
                        android:width="48dp"
                        android:height="24dp" />
                </shape>
            </item>
            <item android:state_checked="false">
                <shape
                    android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#6E7881" />
                    <size
                        android:width="48dp"
                        android:height="24dp" />
                </shape>
            </item>
        </selector>
    </item>
</layer-list>