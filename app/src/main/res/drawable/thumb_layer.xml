<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="24dp"
        android:height="24dp">
        <selector>
            <item android:state_checked="true">
                <shape
                    android:shape="oval">
                    <solid android:color="#20303C" />
                    <stroke
                        android:width="4dp"
                        android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:state_checked="false">
                <shape
                    android:shape="oval">
                    <solid android:color="#20303C" />
                    <stroke
                        android:width="4dp"
                        android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
</layer-list>