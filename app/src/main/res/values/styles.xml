<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MaterialSwitchStyle" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@null</item>
        <item name="android:checked">false</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:scaleX">0.8</item>
        <item name="android:scaleY">0.8</item>
        <item name="android:textOff">@null</item>
        <item name="android:textOn">@null</item>
        <item name="android:thumb">@drawable/thumb_selector</item>
        <item name="thumbTint">@color/thumb_tint_selector</item>
        <item name="track">@drawable/track_selector</item>
        <item name="trackTint">@color/track_tint_selector</item>
    </style>

    <style name="MaterialSliderStyle" parent="Widget.MaterialComponents.Slider">
        <item name="android:elevation">0dp</item>
        <item name="android:stepSize">0.1</item>
        <item name="android:value">0.50</item>
        <item name="android:valueFrom">0.0</item>
        <item name="android:valueTo">100.0</item>
        <item name="android:background">@null</item>
        <item name="haloRadius">0dp</item>
        <item name="labelBehavior">gone</item>
        <item name="thumbColor">#E02828</item>
        <item name="thumbElevation">0dp</item>
        <item name="thumbStrokeColor">#FFFFFF</item>
        <item name="thumbStrokeWidth">1dp</item>
        <item name="tickVisible">false</item>
        <item name="trackColorActive">#E02828</item>
        <item name="trackColorInactive">#6E7881</item>
    </style>

    <style name="MaterialTabStyle" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">#37383B</item>
        <item name="tabGravity">center</item>
        <item name="tabIndicator">@drawable/tab_indicator_slider</item>
        <item name="tabIndicatorColor">#E02828</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorGravity">bottom</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabMaxWidth">150dp</item>
        <item name="tabMinWidth">150dp</item>
        <item name="tabMode">scrollable</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabSelectedTextColor">#FFFFFF</item>
        <item name="tabTextColor">#98999A</item>
        <item name="tabTextAppearance">@style/TabTextAppearance</item>
    </style>

    <style name="MaterialImageButtonStyle" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="haloRadius">0dp</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.AppCompat.Button">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">sans-serif</item>
    </style>

</resources>
