<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#37383B">

    <!-- Основной контент -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Красная панель с кнопкой назад -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#E02828"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Кнопка назад -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Настройки"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Пустой элемент для балансировки -->
            <View
                android:layout_width="24dp"
                android:layout_height="24dp" />

        </LinearLayout>

        <!-- ScrollView с основным контентом -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/scroll_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Основные настройки системы -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="⚙️ ОСНОВНЫЕ НАСТРОЙКИ"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Период контроля -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Период контроля"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/system_tick_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="10 мс"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/system_tick_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:elevation="0dp"
                            android:stepSize="5.0"
                            android:value="5.0"
                            android:valueFrom="5.0"
                            android:valueTo="100.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <!-- Время реакции мотора -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Время реакции мотора"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/motor_delay_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="80 мс"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/motor_delay_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:elevation="0dp"
                            android:stepSize="5.0"
                            android:value="10.0"
                            android:valueFrom="0.0"
                            android:valueTo="250.0"
                            android:visibility="gone"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Время упреждения"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/prediction_horizont_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="90 мс"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/prediction_horizont_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:elevation="0dp"
                            android:stepSize="5.0"
                            android:value="15.0"
                            android:valueFrom="0.0"
                            android:valueTo="250.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Гистререзис положения"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/gyro_hysteresis_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="0.5°"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/gyro_hysteresis_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:elevation="0dp"
                            android:stepSize="0.1"
                            android:value="0.5"
                            android:valueFrom="0.0"
                            android:valueTo="5.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:text="Инвертировать ось X"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/reversed_pitch_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:contentDescription="@string/pitch_switch_description"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:thumb="@drawable/thumb_selector"
                                app:thumbTint="@color/thumb_tint_selector"
                                app:track="@drawable/track_selector"
                                app:trackTint="@color/track_tint_selector" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:text="Инвертировать ось Y"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/reversed_roll_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:contentDescription="@string/roll_switch_description"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:thumb="@drawable/thumb_selector"
                                app:thumbTint="@color/thumb_tint_selector"
                                app:track="@drawable/track_selector"
                                app:trackTint="@color/track_tint_selector" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Угловые параметры -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="📐 УГЛОВЫЕ ПАРАМЕТРЫ"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Целевой угол подъема -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Целевой угол подъема"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/target_pitch_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="25.0°"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/target_pitch_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:elevation="0dp"
                            android:stepSize="1.0"
                            android:value="25.0"
                            android:valueFrom="15.0"
                            android:valueTo="65.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <!-- Зона стабилизации -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Зона стабилизации"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dead_zone_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="0.5°"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/dead_zone_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:elevation="0dp"
                            android:stepSize="0.1"
                            android:value="0.5"
                            android:valueFrom="0.0"
                            android:valueTo="5.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <!-- Порог отключения -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Порог отключения"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/exit_threshold_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="-5.0°"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/exit_threshold_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:elevation="0dp"
                            android:stepSize="1.0"
                            android:value="5.0"
                            android:valueFrom="0.0"
                            android:valueTo="10.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Опасный порог"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/emerg_threshold_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="+5.0°"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/emerg_threshold_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:elevation="0dp"
                            android:stepSize="1.0"
                            android:value="5.0"
                            android:valueFrom="0.0"
                            android:valueTo="10.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Напряжение и шаги -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="⚡ НАПРЯЖЕНИЕ И ШАГИ"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Порог включения -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Порог включения"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/min_voltage_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="1.5 В"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/min_voltage_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:elevation="0dp"
                            android:stepSize="0.1"
                            android:value="1.5"
                            android:valueFrom="0.0"
                            android:valueTo="5.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <!-- Базовый шаг -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Диапазон шагов"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/step_range_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="1 ед"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.RangeSlider
                            android:id="@+id/step_range_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stepSize="1.0"
                            android:value="1.0"
                            android:valueFrom="1.0"
                            android:valueTo="10.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881"
                            app:values="@array/initial_range_values" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Скорость реакции -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🚀 СКОРОСТЬ РЕАКЦИИ"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Коэффициент скорости реакции -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Гистерезис"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hysteresis_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="0.3 Kp"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/hysteresis_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:elevation="0dp"
                            android:stepSize="0.1"
                            android:value="0.3"
                            android:valueFrom="0.0"
                            android:valueTo="1.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <!-- Макс. скорость коррекции -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Макс. угловая скорость"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/max_speed_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="25.0 °/с"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/max_speed_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:elevation="0dp"
                            android:stepSize="10.0"
                            android:value="200"
                            android:valueFrom="0.0"
                            android:valueTo="500.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Время определение тренда"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/trend_duration_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="0.3 Kp"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/trend_duration_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:elevation="0dp"
                            android:stepSize="10.0"
                            android:value="50"
                            android:valueFrom="0.0"
                            android:valueTo="500.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                        <!-- Макс. скорость коррекции -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:text="Время определение покоя"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/stable_duration_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="right"
                                android:paddingEnd="8dp"
                                android:text="25.0 °/с"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/stable_duration_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:elevation="0dp"
                            android:stepSize="10.0"
                            android:value="300"
                            android:valueFrom="0.0"
                            android:valueTo="500.0"
                            app:haloColor="#E02828"
                            app:labelBehavior="gone"
                            app:thumbColor="#E02828"
                            app:thumbElevation="0dp"
                            app:thumbStrokeColor="#FFFFFF"
                            app:thumbStrokeWidth="1dp"
                            app:tickVisible="false"
                            app:trackColorActive="#E02828"
                            app:trackColorInactive="#6E7881" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Предсказание -->

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Панель с кнопками внизу (поверх контента) -->
    <LinearLayout
        android:id="@+id/save_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bottom_panel_gradient"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:text="💾 СОХРАНИТЬ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#4D5963"
            app:cornerRadius="8dp"
            app:strokeColor="#FFFFFF" />

    </LinearLayout>
</FrameLayout>
