package com.example.wheelie_assistant

import android.Manifest
import android.content.Context
import android.content.pm.PackageManager
import android.net.wifi.SoftApConfiguration
import android.net.wifi.WifiManager
import android.net.wifi.WifiManager.LocalOnlyHotspotCallback
import android.net.wifi.WifiManager.LocalOnlyHotspotReservation
import android.os.Build
import android.os.Handler
import android.os.Looper
import android.util.Log
import android.util.SparseIntArray
import androidx.annotation.RequiresApi
import androidx.core.app.ActivityCompat
import androidx.core.content.ContextCompat

class HotSpot(private val context: Context) {
  private val TAG = "HotSpot"
  private val START_TIMEOUT = 10000L

  interface IHotspotCallback {
    fun onStarted(reservation: LocalOnlyHotspotReservation)
    fun onStopped()
    fun onFailed(message: String)
    fun onNotify(message: String)
  }

  private val manager: WifiManager =
    context.applicationContext.getSystemService(Context.WIFI_SERVICE) as WifiManager
  private var hotspotReservation: LocalOnlyHotspotReservation? = null
  private var isStarting = false

  private var hotspotCallback: IHotspotCallback? = null

  fun setCallback(callback: IHotspotCallback) {
    hotspotCallback = callback
  }

  fun hasRequiredPermissions(): Boolean {
    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
      ActivityCompat.checkSelfPermission(
        context,
        Manifest.permission.NEARBY_WIFI_DEVICES
      ) == PackageManager.PERMISSION_GRANTED
    } else {
      ActivityCompat.checkSelfPermission(
        context,
        Manifest.permission.ACCESS_FINE_LOCATION
      ) == PackageManager.PERMISSION_GRANTED
    }
  }

  @RequiresApi(Build.VERSION_CODES.O)
  fun start() {
    if (!hasRequiredPermissions()) {
      Log.w(TAG, "Missing required permissions for hotspot creation")
      hotspotCallback?.onFailed("Missing required permissions for hotspot creation")
    }

    if (isActive()) {
      Log.w(TAG, "Hotspot already active")
      hotspotCallback?.onNotify("Hotspot already active")
    }

    if (isStarting) {
      Log.w(TAG, "Hotspot is already starting")
      hotspotCallback?.onNotify("Hotspot is already starting")
    }

    try {
      isStarting = true

      val mChannels = SparseIntArray(1);
      mChannels.put(SoftApConfiguration.BAND_2GHZ, 0);

      val softApConfiguration = SoftApConfiguration.Builder().setChannels(mChannels).build()

      manager.startLocalOnlyHotspotWithConfiguration(
        softApConfiguration,
        ContextCompat.getMainExecutor(context),
        object : LocalOnlyHotspotCallback() {
          override fun onStarted(reservation: LocalOnlyHotspotReservation) {
            hotspotReservation = reservation
            val config = reservation.softApConfiguration
            Log.d(TAG, "Hotspot created - SSID: ${config.ssid}, Password: ${config.passphrase}, Security: ${config.securityType}")
            hotspotCallback?.onStarted(reservation)
          }

          override fun onStopped() {
            hotspotReservation = null
            Log.d(TAG, "Hotspot stopped")
            hotspotCallback?.onStopped()
          }

          override fun onFailed(reason: Int) {
            hotspotReservation = null
            Log.e(TAG, "Failed to create hotspot: $reason")
            hotspotCallback?.onFailed("Failed to create hotspot: $reason")
          }
        }
      )

      Handler(Looper.getMainLooper()).postDelayed({
        if (isStarting) {
          stop()
          Log.w(TAG, "Hotspot creation timeout")
          hotspotCallback?.onFailed("Hotspot creation timeout")
        }
      }, START_TIMEOUT)
    } catch (e: SecurityException) {
      Log.e(TAG, "Hotspot security error", e)
      hotspotCallback?.onFailed("Hotspot security error: ${e.message}")
    } catch (e: Exception) {
      Log.e(TAG, "Error creating hotspot", e)
      hotspotCallback?.onFailed("Error creating hotspot: ${e.message}")
    } finally {
      isStarting = false
    }
  }

  @RequiresApi(Build.VERSION_CODES.R)
  private fun force24GHzBand(builder: SoftApConfiguration.Builder) {
    try {
      val setChannelMethod = builder::class.java.getDeclaredMethod(
        "setChannel",
        Int::class.javaPrimitiveType,
        Int::class.javaPrimitiveType
      )
      setChannelMethod.invoke(builder, 6, SoftApConfiguration.BAND_2GHZ)
      Log.d(TAG, "Successfully set channel 6 on 2.4GHz band")
    } catch (e: Exception) {
      Log.w(TAG, "setChannel method not available, trying setBand...")
      try {
        val setBandMethod = builder::class.java.getDeclaredMethod(
          "setBand",
          Int::class.javaPrimitiveType
        )
        setBandMethod.invoke(builder, SoftApConfiguration.BAND_2GHZ)
        Log.d(TAG, "Successfully set 2.4GHz band")
      } catch (e2: Exception) {
        Log.e(TAG, "Both setChannel and setBand methods are unavailable", e2)
        // Продолжаем без установки диапазона
      }
    }
  }

  fun getSSID(): String? {
    return hotspotReservation?.softApConfiguration?.ssid
//    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
//      hotspotReservation?.softApConfiguration?.wifiSsid?.toString()
//    } else {
//      hotspotReservation?.softApConfiguration?.ssid
//    }
  }

  fun getPassword(): String? {
    return hotspotReservation?.softApConfiguration?.passphrase
  }

  fun stop() {
    try {
      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
        hotspotReservation?.close()
        hotspotReservation = null
        Log.d(TAG, "Hotspot stopped")
      } else {
        Log.w(TAG, "Automatic hotspot stop not supported on this Android version")
      }
    } catch (e: Exception) {
      Log.e(TAG, "Error stopping hotspot", e)
    }
  }

  fun isActive(): Boolean {
    return Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && hotspotReservation != null
  }
}